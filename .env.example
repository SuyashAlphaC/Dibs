# Client-side Privy app ID. Without it, the app uses an explicit demo identity.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only Privy secret used to resolve embedded wallets to linked Farcaster profiles.
PRIVY_APP_SECRET=

# Deployed Dibs contract on Monad. Without it, stake actions simulate locally.
NEXT_PUBLIC_DIBS_CONTRACT_ADDRESS=
NEXT_PUBLIC_SPONSOR_TRANSACTIONS=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_CRE_SETTLEMENT_MODE=don
# Local settlement script guard. Keep `don` for production; use `simulation` only for the isolated fallback.
CRE_SETTLEMENT_MODE=don
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Server-only Neynar key. Without it, the API route returns curated demo casts.
NEYNAR_API_KEY=

# Server-side Envio endpoint used by feed, market, and settlement routes.
ENVIO_GRAPHQL_URL=
# Optional browser-visible fallback for deployments that already use this variable.
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=

# Stable public origin used by the Farcaster Mini App manifest.
NEXT_PUBLIC_APP_URL=https://dibs-metropolis.vercel.app
# Signed JSON object generated by the domain owner in Farcaster Developer Tools.
FARCASTER_ACCOUNT_ASSOCIATION=

# Server-only market keeper. Never prefix these with NEXT_PUBLIC_.
MARKET_OPENER_PRIVATE_KEY=
CRON_SECRET=
# Operator-only QStash API credential used to create/inspect the external schedule.
# Keep this in GitHub Actions as QSTASH_TOKEN; the deployed app does not require it.
QSTASH_TOKEN=
# Dibs uses QStash's US region to stay close to the Vercel iad1 deployment.
QSTASH_BASE_URL=https://qstash-us-east-1.upstash.io
# Emergency switch for all keeper writes. Fail-closed when unset.
MARKET_AUTOMATION_ENABLED=false
# Separate switch for new epochs/markets so lifecycle maintenance can remain active.
MARKET_OPENING_ENABLED=false
# Authenticated Farcaster scouts may nominate only into an existing funded epoch.
PUBLIC_NOMINATIONS_ENABLED=false
MARKET_SOURCE_CHANNELS=farcaster,monad,ethereum,builders
MAX_MARKETS_PER_RUN=4
MAX_MAINTENANCE_TRANSACTIONS_PER_RUN=8
PUBLIC_NOMINATION_MARKET_CAP=12
MARKET_EPOCH_SEED_MON=0.02
MARKET_MAX_EPOCH_SEED_MON=0.05
MARKET_MIN_OPERATOR_BALANCE_MON=0.5
MARKET_MIN_AUTHOR_SCORE=0.6
MARKET_MIN_AUTHOR_AGE_DAYS=30
MARKET_MIN_CAST_CHARACTERS=48
# Optional deployment migration boundary; older markets remain available by direct URL/history.
MARKET_QUALITY_GATE_ACTIVATED_AT=
# Optional single testnet market used to demonstrate the optimistic challenge lifecycle.
CHALLENGE_DEMO_MARKET_ID=
# Disabled by default. Enable only for one explicitly labelled adversarial rehearsal.
CHALLENGE_DEMO_ENABLED=false

# Contract deployment inputs. Use the official CRE forwarder for the target Monad network.
CRE_FORWARDER_ADDRESS=
# Operational input used to pin the workflow on the receiver after workflow deployment.
CRE_WORKFLOW_ID=
CRE_SETTLEMENT_RECEIVER_ADDRESS=
CRE_SIMULATION_RECEIVER_ADDRESS=
CRE_MOCK_FORWARDER_ADDRESS=
CRE_RECEIVER_OWNER_PRIVATE_KEY=
CRE_ETH_PRIVATE_KEY=
# Headless Chainlink CRE CLI authentication for CI. Store only as a GitHub secret.
CRE_API_KEY=
